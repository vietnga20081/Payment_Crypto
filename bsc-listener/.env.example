# ──────────────────────────────────────
# Database (MySQL) — dùng chung DB với gateway-api
# ──────────────────────────────────────
DATABASE_URL="mysql://cgw_user:your_password@127.0.0.1:3306/crypto_gateway"

# ──────────────────────────────────────
# Redis — dùng chung Redis với gateway-api (webhook queue, heartbeat)
# ──────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ──────────────────────────────────────
# BSC / Blockchain
# RPC công khai: https://bsc-dataseed.binance.org — nên đổi sang RPC riêng
# (Ankr, QuickNode, NodeReal...) khi lên production để tránh rate limit.
# ──────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# ──────────────────────────────────────
# BSC Listener
# ──────────────────────────────────────
POLL_INTERVAL_MS=3000
CONFIRMATION_POLL_MS=10000
