# ──────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────
DATABASE_URL="mysql://cgw_user:your_password@127.0.0.1:3306/crypto_gateway"

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ──────────────────────────────────────
# JWT (tạo bằng: openssl rand -hex 64)
# ──────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_64_char_random_string
JWT_REFRESH_SECRET=change_this_to_another_64_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────
# API Server
# ──────────────────────────────────────
PORT=3007
NODE_ENV=production
FRONTEND_URL=https://payment.v3vn.eu

# ──────────────────────────────────────
# Tron / Blockchain
# ──────────────────────────────────────
TRON_NODE_URL=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ──────────────────────────────────────
# Tron Listener
# ──────────────────────────────────────
POLL_INTERVAL_MS=3000
CONFIRMATION_POLL_MS=10000

# ──────────────────────────────────────
# Webhook
# ──────────────────────────────────────
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
