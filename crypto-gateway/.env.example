# ──────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────
DATABASE_URL="mysql://cgw_user:your_password@127.0.0.1:3306/crypto_gateway"

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ──────────────────────────────────────
# JWT (tạo bằng: openssl rand -hex 64)
# ──────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_64_char_random_string
JWT_REFRESH_SECRET=change_this_to_another_64_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────
# API Server
# ──────────────────────────────────────
PORT=3007
NODE_ENV=production
FRONTEND_URL=https://payment.v3vn.eu

# ──────────────────────────────────────
# Tron / Blockchain
# ──────────────────────────────────────
TRON_NODE_URL=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ──────────────────────────────────────
# Mã hoá private key ví (bắt buộc — tạo bằng: openssl rand -hex 32)
# ⚠️ Mất key này = mất khả năng giải mã toàn bộ private key ví đã mã hoá.
# Backup key này ở nơi an toàn, TÁCH RIÊNG khỏi backup database.
# ──────────────────────────────────────
WALLET_ENCRYPTION_KEY=

# ──────────────────────────────────────
# Tron Listener
# ──────────────────────────────────────
POLL_INTERVAL_MS=3000
CONFIRMATION_POLL_MS=10000

# ──────────────────────────────────────
# BSC / Blockchain (bsc-listener — USDT-BEP20)
# RPC công khai: https://bsc-dataseed.binance.org — nên đổi sang RPC riêng
# (Ankr, QuickNode, NodeReal...) khi lên production để tránh rate limit.
# ──────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# ──────────────────────────────────────
# Webhook
# ──────────────────────────────────────
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3

# ──────────────────────────────────────
# Giám sát & Cảnh báo (Telegram)
# Tạo bot: nhắn @BotFather -> /newbot -> lấy token
# Lấy chat_id: nhắn bot rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
# ──────────────────────────────────────
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MS=600000
WATCHDOG_INTERVAL_MS=60000
HEARTBEAT_STALE_THRESHOLD_MS=300000
WEBHOOK_FAILED_ALERT_THRESHOLD=20
# Danh sách listener cần theo dõi heartbeat, phân tách bằng dấu phẩy
WATCHDOG_LISTENERS=tron-listener,bsc-listener
